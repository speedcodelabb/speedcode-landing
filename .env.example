# Supabase — variables públicas (usadas por el cliente, se incluyen en el bundle)
# Se leen con import.meta.env en el frontend. Sin estas dos, la landing usa su
# copia base y el panel permanece cerrado; no existe un modo demo administrativo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Supabase — variable privada, SOLO para funciones serverless (api/*.ts)
# Nunca debe exponerse al cliente ni tener el prefijo VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_HASH_SECRET=
RESEND_API_KEY=
RESEND_FROM=Speedcode Lab <contactos@speedcodelab.com>
CONTACT_NOTIFICATION_TO=soluciones@speedcodelab.com

# Primera barrera del panel privado. Configurar valores distintos por entorno.
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=

# Solo para el script db:add-admin.
ADMIN_USER_ID=
ADMIN_DISPLAY_NAME=
