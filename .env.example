# Supabase — variables públicas (usadas por el cliente, se incluyen en el bundle)
# Se leen con import.meta.env en el frontend. Sin estas dos, el sitio y el panel
# de administración funcionan en "modo demo local" (sin persistencia real).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — variable privada, SOLO para funciones serverless (api/*.ts)
# Nunca debe exponerse al cliente ni tener el prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
